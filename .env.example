# Which provider to use. Only "discord" ships as an example; add your own in
# src/providers and register it in src/config.mjs.
PROVIDER=discord

# Bearer/user token for the check route, obtained with `npm run auth`. Can also
# be pasted here directly. Leave blank for a provider whose check needs no token.
API_TOKEN=

# Optional secret some providers require in the body of a claim/change request.
# The discord example sends the account password here. Leave blank if unused or
# if you never enable claiming.
API_SECRET=

# Targets to watch, comma-separated. The first one seen available is reported
# (and claimed, if claiming is on).
WATCH_TARGETS=abcd,efgh

# Dry run: true = only detect and notify, never claim (default).
DRY_RUN=true

# Enable the optional claim action. Off by default; also needs DRY_RUN=false.
CLAIM=false

# Check-route budget: how many checks per window, spread evenly across it.
# 30 per 60s is roughly one every two seconds; the limiter adapts from here.
CHECK_BUDGET=30
CHECK_WINDOW_SEC=60

# Floor for the interval between requests, in ms.
MIN_REQUEST_INTERVAL_MS=900

# Pause between full passes over the target list, in ms.
CYCLE_DELAY_MS=1500

# Copy of the log without ANSI codes. Blank = console only.
LOG_FILE=

# Optional webhook; a plain JSON event is POSTed on availability/claim.
WEBHOOK_URL=

# Terminal bell (BEL) on an event.
BEEP=true

# Provider-specific: client build number the discord example puts in its headers.
CLIENT_BUILD_NUMBER=354600
